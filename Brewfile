# Brewfile — pacotes instalados via `brew bundle`
# Edite à vontade e rode `brew bundle` para aplicar.

# --- Ferramentas de linha de comando ---
brew "git"          # git atualizado (mais novo que o do sistema)
brew "gh"           # GitHub CLI
brew "fnm"          # Fast Node Manager (gerencia versões do Node)
brew "starship"                  # prompt do terminal (bonito e rápido)
brew "zsh-autosuggestions"       # sugere comandos do histórico
brew "zsh-syntax-highlighting"   # colore o comando enquanto digita

# --- CLI modernas (produtividade no terminal) ---
brew "fzf"          # busca fuzzy (Ctrl+R no histórico, Ctrl+T em arquivos)
brew "zoxide"       # cd inteligente (comando `z`)
brew "eza"          # ls moderno com ícones e git
brew "bat"          # cat com syntax highlight
brew "fd"           # find mais simples e rápido
brew "ripgrep"      # grep ultrarrápido (rg)
brew "jq"           # processa JSON
brew "lazygit"      # TUI de git
brew "git-delta"    # diffs bonitos no git
brew "btop"         # monitor de sistema

# --- Apps ---
cask "orbstack"             # Docker/containers leve para Apple Silicon
cask "visual-studio-code"   # editor
cask "ghostty"              # terminal
cask "google-chrome"        # navegador
cask "bruno"                # cliente de API (offline, git-friendly)
cask "mos"                  # controla scroll do mouse/trackpad separadamente (opcional)
cask "font-jetbrains-mono-nerd-font"   # fonte com ícones (pro prompt do Starship)
